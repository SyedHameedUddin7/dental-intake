# Postgres connection (Supabase). Privileged connection used by the server API.
DATABASE_URL=

# Supabase project (browser client + server auth)
SUPABASE_URL=
SUPABASE_KEY=
# Secret key (sb_secret_...). Used server-side to create/delete staff logins
# from the admin page. Never exposed to the browser.
# Dashboard -> Project Settings -> API keys -> Secret key.
SUPABASE_SECRET_KEY=

# Groq (free Llama inference). Get a key at https://console.groq.com
GROQ_API_KEY=
# Optional: override the model (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Deepgram (speech-to-text). Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=
# Optional: override the STT model (defaults to nova-3)
# DEEPGRAM_MODEL=nova-3
